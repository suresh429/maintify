<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 15+ (API 35+) — edge-to-edge is enforced by the platform.
  setStatusBarColor / setNavigationBarColor are ignored by the OS.
  Flutter manages system bar insets via WindowCompat internally.
  Do NOT set windowDrawsSystemBarBackgrounds here — it is deprecated
  on API 35 and Flutter's embedding handles it correctly.
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
