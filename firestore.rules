rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // Super admin — role stored as 'admin' in Firestore (UserRole.admin)
    function isSuperAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Apartment admin / president — role stored as 'president' in Firestore (UserRole.president)
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'president';
    }

    function isAdminForApartment(aptId) {
      return isAdmin() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.apartmentId == aptId;
    }

    function isMemberOfApartment(aptId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.apartmentId == aptId;
    }

    // ── _meta (seeder flag) ──────────────────────────────────────────────────
    // Read is open so DbSeeder can check the guard before seeding.
    // Write is restricted to super admin so only a real admin can delete/reset
    // the guard — prevents anyone from wiping seeded_v4 to re-trigger the seed.
    match /_meta/{doc} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Email uniqueness check during signup requires unauthenticated read.
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if request.auth.uid == userId || isAdmin() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── Resident registration requests ──────────────────────────────────────
    // create is allowed without auth: the resident's Auth account is created
    // then signed out before this write happens (to avoid auto-login).
    // Reads are restricted to admins/superAdmins to protect PII.
    match /resident_requests/{requestId} {
      allow read: if isAdmin() || isSuperAdmin();
      allow create: if true; // signup flow: auth account exists but not signed in
      allow update: if isAdmin() || isSuperAdmin();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ── mail (Firebase Trigger Email extension) ──────────────────────────────
    // Only Cloud Functions (server-side) should write here.
    // Deny all client reads/writes for security.
    match /mail/{docId} {
      allow read, write: if false;
    }

    // ── Flats ────────────────────────────────────────────────────────────────
    // Read is open: unauthenticated signup flow looks up flat availability.
    // Create: super admin, apartment president, OR a signed-in user claiming
    //         the flat for themselves (resident on-demand flat creation).
    // Update: super admin, president, or any signed-in user (resident claiming flat on registration).
    match /flats/{flatId} {
      allow read: if true;
      allow create: if isSuperAdmin() ||
                       isAdminForApartment(request.resource.data.apartmentId) ||
                       (isSignedIn() && request.resource.data.residentId == request.auth.uid);
      allow update: if isSuperAdmin() || isAdminForApartment(resource.data.apartmentId) || isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // ── Apartments ───────────────────────────────────────────────────────────
    // Read is open to allow apartment code lookup during unauthenticated signup.
    // create: super admin, OR a signed-in user self-registering as president
    //         (presidentId must equal their own UID).
    // update: super admin, apartment president, OR:
    //   - a signed-in user setting themselves as president (activation flow, user
    //     doc doesn't exist yet when the batch commits so isAdminForApartment fails)
    //   - any signed-in user touching only occupiedFlats+updatedAt (resident signup)
    match /apartments/{aptId} {
      allow read: if true;
      allow create: if isSuperAdmin() ||
                       (isSignedIn() && request.resource.data.presidentId == request.auth.uid);
      allow update: if isSuperAdmin() ||
                       isAdminForApartment(aptId) ||
                       (isSignedIn() && request.resource.data.presidentId == request.auth.uid) ||
                       (isSignedIn() &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['occupiedFlats', 'updatedAt']));
      allow delete: if isSuperAdmin();
    }

    // ── Bills ────────────────────────────────────────────────────────────────
    match /bills/{billId} {
      allow read: if isMemberOfApartment(resource.data.apartmentId) || isSuperAdmin();
      allow create, update: if isAdminForApartment(request.resource.data.apartmentId) || isSuperAdmin();
      allow delete: if isAdminForApartment(resource.data.apartmentId) || isSuperAdmin();
    }

    // ── Payments ─────────────────────────────────────────────────────────────
    match /payments/{paymentId} {
      allow read: if isMemberOfApartment(resource.data.apartmentId) ||
                     request.auth.uid == resource.data.userId ||
                     isSuperAdmin();
      allow create: if request.auth.uid == request.resource.data.userId ||
                       isAdminForApartment(request.resource.data.apartmentId) ||
                       isSuperAdmin();
      allow update: if isAdminForApartment(resource.data.apartmentId) ||
                       request.auth.uid == resource.data.userId ||
                       isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── Complaints ───────────────────────────────────────────────────────────
    match /complaints/{complaintId} {
      // Allow apartment members (president) OR the complaint owner (resident).
      // The `request.auth.uid == resource.data.userId` alternative avoids a
      // get() call for resident queries filtered by userId — preventing
      // PERMISSION_DENIED on fresh auth connections where get() may be slow.
      allow read: if isMemberOfApartment(resource.data.apartmentId) ||
                     request.auth.uid == resource.data.userId ||
                     isSuperAdmin();
      allow create: if isSignedIn();
      allow update: if isAdminForApartment(resource.data.apartmentId) ||
                       request.auth.uid == resource.data.userId;
      allow delete: if isAdminForApartment(resource.data.apartmentId) || isSuperAdmin();

      // Messages subcollection
      // Simplified to isSignedIn() — the parent complaint read rule already
      // controls who can see the complaint (and therefore know the complaintId).
      // Removing the double-nested get() (complaint→user) prevents PERMISSION_DENIED
      // on fresh auth connections.
      match /messages/{msgId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if false; // messages are immutable
        allow delete: if isSuperAdmin(); // only super admin can delete (apartment deletion)
      }
    }

    // ── Meetings ─────────────────────────────────────────────────────────────
    match /meetings/{meetingId} {
      allow read: if isMemberOfApartment(resource.data.apartmentId) || isSuperAdmin();
      allow create, update: if isAdminForApartment(request.resource.data.apartmentId) || isSuperAdmin();
      allow delete: if isAdminForApartment(resource.data.apartmentId) || isSuperAdmin();
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    // Read is scoped to the notification's owner; admins can read all for
    // management purposes. App-level queries always add userId == currentUser.
    // create is open to all signed-in users: residents write notifications for
    // presidents when sending complaint messages; presidents write for residents
    // when replying. The app controls targeting — no server-side restriction
    // is needed beyond requiring authentication.
    match /notifications/{notifId} {
      allow read: if isSignedIn() &&
                     (request.auth.uid == resource.data.userId ||
                      isAdmin() || isSuperAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn(); // mark as read
      allow delete: if isSuperAdmin();
    }

    // ── President invitations ─────────────────────────────────────────────────
    match /president_invitations/{invId} {
      allow read: if isSuperAdmin() || isSignedIn();
      allow create, update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── Settings ─────────────────────────────────────────────────────────────
    // Global app configuration. SuperAdmin can manage; all signed-in users can
    // read (feature flags, maintenance banners, etc.).
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin();
    }
  }
}
